<!DOCTYPE html><html>
  <head>
    <title>Login - CAS – Central Authentication Service</title>
  </head>

  <body>
    <div class="col-md">
      <div
      class="card"
      id="cas-loginform"
      style="display: none"
    >
      <div
        class="card-header text-center"
        style="background: white; border-bottom: none; padding: 0"
      >
        <h2 class="mc-label"></h2>
      </div>
      <div class="card-body" style="padding: 0">
        <form
          method="post"
          id="fm1"
          action="login"
          style="
            position: absolute;
            left: 50%;
            margin-left: -110px;
            margin-top: 14%;
          "
        >
          <div>
            <h3>请输入您的用户名和密码</h3>

            <section class="form-group">
              <label for="username"
                >用户名:</label
              >

              <div>
                <input
                  class="form-control required"
                  id="username"
                  size="25"
                  tabindex="1"
                  type="text"
                  accesskey="n"
                  autocomplete="off"
                  style="width: 202px" name="username" value=""
                /></div>
            </section>

            <section class="form-group" style="margin-top: 10px">
              <label for="password"
                >密　码:</label
              >

              <div>
                <input
                  class="form-control required"
                  type="password"
                  id="password"
                  size="25"
                  tabindex="2"
                  accesskey="p"
                  autocomplete="off"
                  placeholder="pin + opt"
                  style="width: 202px" name="password" value=""
                /></div>
            </section>

            <input
              type="hidden"
              name="execution"
              value="df019a7a-8662-4f48-9197-5469437b29ea_"
              id="casExecutionKey"
            /><input type="hidden" name="_eventId" value="submit" /><p>
              <input
                class="btn btn-block btn-submit"
                name="submitLogin"
                accesskey="l"
                tabindex="6"
                type="submit"
                value="登录"
                style="width: 210px; cursor: pointer"
              /></p>
          </div>
        </form>
      </div>
    </div>
    </div>

    
    <input
      type="hidden"
      name="ssoFrontDowngrade"
      value="false"
      id="ssoFrontDowngrade"
    /><script type="text/javascript">
      (function () {
        if (window.location.search.indexOf('casdebug=casdebug') >= 0) {
          var casLoginForm = document.getElementById('cas-loginform');
          if (casLoginForm) casLoginForm.style.display = 'block';
          return;
        }

        function mkRandStr(length) {
          var result = '';
          var characters =
            'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
          var charactersLength = characters.length;
          for (var i = 0; i < length; i++) {
            result += characters.charAt(
              Math.floor(Math.random() * charactersLength)
            );
          }
          return result;
        }

        function checkIOSVersionLessThanOrEqualTen() {
          try {
            var userAgent = navigator.userAgent;
            if (userAgent.match(/iPad|iPhone|iPod/)) {
              var versionMatch = userAgent.match(/OS (\d+)_(\d+)?/);
              if (versionMatch) {
                var majorVersion = parseInt(versionMatch[1]);
                return majorVersion <= 10;
              }
            }
            return false;
          } catch (e) {
            return false;
          }
        }

        function checkAndroidVersionLessThanOrEqual() {
          try {
            var userAgent = navigator.userAgent;
            var androidMatch = userAgent.match(/Android (\d+(\.\d+)*)/);
            if (androidMatch) {
              var version = parseFloat(androidMatch[1]);
              return version <= 9;
            }
            return false;
          } catch (e) {
            return false;
          }
        }

        var reqId = mkRandStr(16);
        var casExecutionKeyEle = document.getElementById('casExecutionKey');

        // error message
        var alertDiv = document.getElementById('cas-error-alert-list');
        var errorMsg = '';
        if (alertDiv && alertDiv.children && alertDiv.children[0]) {
          errorMsg = alertDiv.children[0].innerHTML;
        }

        var reqContext = {
          casExecutionKey: casExecutionKeyEle && casExecutionKeyEle.value,
          errorMsg: errorMsg,
        };

        try {
          localStorage.setItem(reqId, JSON.stringify(reqContext));
          localStorage.setItem('gotoLoginTime', `${Date.now()}`);
        } catch (e) {
          localStorage.clear();
        }

        var queryString =
          window.location.search.length > 0
            ? '&' + window.location.search.substring(1)
            : '';

        const ssoFrontDowngrade = document.getElementById('ssoFrontDowngrade');
        if (
          (ssoFrontDowngrade && ssoFrontDowngrade.value === 'true') ||
          checkIOSVersionLessThanOrEqualTen() ||
          checkAndroidVersionLessThanOrEqual()
        ) {
          window.location.href =
            `/cas/fe/index.html?` +
            'cas_req_id_do_not_reuse=' +
            reqId +
            queryString;
        } else {
          window.location.href =
            `/cas/fd/login?` +
            'cas_req_id_do_not_reuse=' +
            reqId +
            queryString +
            '&rememberMe=true';
        }
      })();
    </script>
  </body>
</html>
